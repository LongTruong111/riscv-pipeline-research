REPO_ROOT := $(CURDIR)

SIM ?= verilator
TOPLEVEL_LANG = verilog

VERILOG_SOURCES = \
	$(REPO_ROOT)/design/RegPack.sv \
	$(filter-out $(REPO_ROOT)/design/RegPack.sv,$(sort $(wildcard $(REPO_ROOT)/design/*.sv))) \
	$(sort $(wildcard $(REPO_ROOT)/design/*.v))

TOPLEVEL = riscv
MODULE = test_full_dut_throughput

SIM_BUILD := $(REPO_ROOT)/research/week5/preflight/sim_build_full_dut

export PYTHONPATH := $(REPO_ROOT)/research/week5/preflight:$(PYTHONPATH)

ifeq ($(SIM),verilator)
COMPILE_ARGS += -Wno-fatal
endif

include $(shell cocotb-config --makefiles)/Makefile.sim
